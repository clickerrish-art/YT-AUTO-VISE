{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonicvhibez-durable-state-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "STATE_DB",
      "database_name": "sonicvhibez-state-staging",
      "database_id": "f018ee20-2d7f-41ec-9744-ee058bce80f8",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "sonicvhibez-artifacts-staging"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
