# Copy to .env for local development. Never commit actual credentials.
DASHBOARD_HOST=127.0.0.1
PORT=8787
DASHBOARD_OPERATOR_TOKEN=
DASHBOARD_OPERATOR_ID=
# Optional least-privilege worker credential; can only list and dispatch approved authoring jobs.
DASHBOARD_WORKER_TOKEN=
DASHBOARD_WORKER_ID=sonicvhibez-render-worker
# Ed25519 quarantine-release signing. Generate with:
#   openssl genpkey -algorithm ED25519 -out quarantine-release-private.pem
#   openssl pkey -in quarantine-release-private.pem -pubout -out quarantine-release-public.pem
# Install the PRIVATE PEM only in the dashboard secret store; never on workers.
DASHBOARD_QUARANTINE_SIGNING_PRIVATE_KEY=
# Separate high-entropy credential used only by the authorized operator to request release signatures.
# Do not install this credential on worker hosts. Run the manual release command from an authorized operator host
# with access to the stopped worker state directory. A stale .process.lock must be inspected before removal.
DASHBOARD_QUARANTINE_RELEASE_TOKEN=
# Install only the matching PUBLIC PEM on worker hosts. Never copy the private key here.
DASHBOARD_QUARANTINE_SIGNING_PUBLIC_KEY=
DASHBOARD_API_URL=http://127.0.0.1:8787
WORKER_POLL_INTERVAL_MS=5000
# Durable worker retry/backoff state; keep this directory on persistent private storage.
WORKER_STATE_DIR=run-logs
DASHBOARD_STATE_DIR=state

# Only configure in a secure local environment when the owner is ready for a private upload.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
SONICVHIBEZ_CHANNEL_ID=
# Owner-reviewed complete inventory matching every video in the authenticated uploads playlist.
CHANNEL_HISTORY_RECONCILIATION_PATH=
# Separate one-shot authorization JSON bound to job, final video/metadata/approval hashes and verified channel.
PRIVATE_UPLOAD_AUTHORIZATION_PATH=
CONFIRM_PRIVATE_UPLOAD=NO

# Nature Frontiers Facebook Page. Keep tokens in a secure runtime secret store, never in source control.
# Autonomous publishing also requires an owner-controlled persistent runner and durable state directory.
NATURE_FRONTIERS_FACEBOOK_PAGE_ID=
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
FACEBOOK_STATE_DIR=
# Config remains publishingEnabled=false, dryRun=true and emergencyStop=true until verified setup.
# These values do not override the fail-closed JSON configuration.
FACEBOOK_PUBLISH_ENABLED=NO
FACEBOOK_AUTONOMOUS_QUEUE_PATH=
JOB_ID=
UPLOAD_APPROVAL_PATH=
UPLOAD_LOG_DIR=run-logs
