{
  "name": "sonicvhibez-shorts-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Safety-first SonicVhibez Shorts and long-form metadata validation, rendering and private-upload tooling.",
  "scripts": {
    "check": "node scripts/check-content.mjs",
    "test": "node --test",
    "upload:private": "node scripts/upload-private.mjs",
    "check:captions": "node scripts/check-captions.mjs content/short-001-wildlife-video-storytelling.srt content/short-002-plan-wildlife-documentary.srt",
    "preflight:media": "node scripts/preflight-media.mjs",
    "render:short": "node scripts/render-short.mjs",
    "readiness": "node scripts/production-readiness.mjs",
    "render:thumbnail": "node scripts/render-thumbnail.mjs",
    "render:long": "node scripts/render-long-form.mjs",
    "validate:long-export": "node scripts/validate-long-form-export.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  }
}
